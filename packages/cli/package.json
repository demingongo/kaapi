{
    "name": "@kaapi/cli",
    "version": "0.0.47",
    "description": "CLI for kaapi",
    "main": "dist/definitions.js",
    "exports": {
        "./definitions": {
            "types": "./dist/definitions.d.ts",
            "default": "./dist/definitions.js"
        },
        "./utils": {
            "types": "./dist/utils.d.ts",
            "default": "./dist/utils.js"
        }
    },
    "bin": {
        "kaapi": "dist/index.js"
    },
    "scripts": {
        "lint": "eslint .",
        "build": "tsc",
        "format": "prettier --write ./",
        "format:check": "prettier --check ./",
        "test:run": "ts-node src/index.ts",
        "test:bin": "node dist/index.js"
    },
    "author": "demingongo",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/demingongo/kaapi.git",
        "directory": "packages/cli"
    },
    "license": "MIT",
    "dependencies": {
        "@clack/prompts": "^1.4.0",
        "lodash": "^4.18.1",
        "mri": "^1.2.0",
        "tslib": "^2.8.1"
    },
    "devDependencies": {
        "@types/lodash": "^4.17.24"
    }
}
