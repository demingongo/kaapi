{
    "name": "@kaapi/oauth2-auth-design",
    "version": "0.0.48",
    "private": false,
    "description": "OAuth2 auth design for kaapi",
    "main": "lib/index.js",
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "default": "./lib/index.js"
        },
        "./cli": {
            "types": "./lib/cli.d.ts",
            "default": "./lib/cli.js"
        }
    },
    "keywords": [
        "kaapi",
        "oauth2",
        "oidc",
        "authentication",
        "authorization",
        "openid-connect",
        "security",
        "access-token",
        "jwt"
    ],
    "scripts": {
        "lint": "eslint .",
        "build": "tsc && node ./scripts/buildDT.mjs",
        "doc": "typedoc",
        "format": "prettier --write ./",
        "format:check": "prettier --check ./",
        "test:unit": "kaukau -r ts-node/register -f test --ext .spec.ts",
        "test": "kaukau --require ts-node/register --config kaukau.config.mjs"
    },
    "author": "demingongo",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/demingongo/kaapi.git",
        "directory": "packages/oauth2-auth-design"
    },
    "license": "MIT",
    "dependencies": {
        "@hapi/boom": "^10.0.1",
        "@hapi/hoek": "^11.0.7",
        "@kaapi/cli": "workspace:^",
        "@kaapi/kaapi": "workspace:^",
        "@novice1/api-doc-generator": "^1.2.6",
        "tslib": "^2.8.1"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10"
    },
    "peerDependencies": {
        "@saurbit/oauth2": "^0.1.14",
        "@saurbit/oauth2-jwt": "^0.1.10"
    }
}
