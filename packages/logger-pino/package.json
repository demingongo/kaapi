{
    "name": "@kaapi/logger-pino",
    "version": "0.0.48",
    "private": false,
    "description": "A customized Pino logger wrapper featuring predefined 'silly' and 'verbose' log levels.",
    "main": "lib/index.js",
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "default": "./lib/index.js"
        }
    },
    "scripts": {
        "lint": "eslint .",
        "build": "tsc",
        "format": "prettier --write ./",
        "format:check": "prettier --check ./",
        "test": "kaukau --require ts-node/register --config kaukau.config.mjs"
    },
    "keywords": [
        "kaapi",
        "typescript",
        "pino",
        "logger",
        "logging"
    ],
    "author": "demingongo",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/demingongo/kaapi.git",
        "directory": "packages/logger-pino"
    },
    "license": "MIT",
    "dependencies": {
        "@kaapi/logger": "workspace:^",
        "pino": "^10.3.1",
        "pino-pretty": "^13.1.3",
        "tslib": "^2.8.1"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10"
    }
}
