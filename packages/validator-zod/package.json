{
    "name": "@kaapi/validator-zod",
    "version": "0.0.44",
    "private": false,
    "description": "Zod-powered request validation and documentation plugin for Kaapi.",
    "main": "lib/index.js",
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "default": "./lib/index.js"
        }
    },
    "scripts": {
        "lint": "eslint .",
        "build": "tsc && node ./scripts/buildDT.mjs",
        "format": "prettier --write ./",
        "format:check": "prettier --check ./",
        "test": "kaukau --require ts-node/register --config kaukau.config.mjs",
        "coverage": "c8 npm test"
    },
    "keywords": [
        "kaapi",
        "hapi",
        "zod",
        "typescript",
        "validation"
    ],
    "author": "demingongo",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/demingongo/kaapi.git",
        "directory": "packages/validator-zod"
    },
    "license": "MIT",
    "dependencies": {
        "@hapi/boom": "^10.0.1",
        "@kaapi/kaapi": "workspace:^",
        "@novice1/api-doc-zod-helper": "^0.1.10",
        "tslib": "^2.8.1",
        "zod": "^4.3.6"
    },
    "peerDependencies": {
        "zod": "^4.0.0"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10"
    }
}
