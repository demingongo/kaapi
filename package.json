{
  "name": "kaapi",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "pnpm -r build",
    "doc": "pnpm --filter \"./packages/*\" -r doc",
    "format": "pnpm --filter \"./packages/*\" -r format",
    "format:check": "pnpm --filter \"./packages/*\" -r format:check",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:integration": "pnpm -r test",
    "release:build": "pnpm --filter \"./packages/*\" -r build",
    "release:test": "pnpm --filter \"./packages/*\" -r test",
    "release:version": "pnpm --filter \"./packages/*\" -r exec npm version",
    "release:publish": "pnpm --filter \"./packages/*\" -r publish --access public",
    "version:patch": "pnpm --filter \"./packages/*\" -r exec npm version patch",
    "version:minor": "pnpm --filter \"./packages/*\" -r exec npm version minor",
    "version:major": "pnpm --filter \"./packages/*\" -r exec npm version major"
  },
  "keywords": [],
  "author": "demingongo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/demingongo/kaapi.git"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.20.0",
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@stylistic/eslint-plugin": "^5.6.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.0",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.0.2",
    "@types/sinon": "^21.0.0",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "c8": "^10.1.3",
    "chai": "^6.2.1",
    "dependency-cruiser": "^17.3.4",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^16.5.0",
    "kaukau": "^4.1.7",
    "mocha": "^11.7.5",
    "nodemon": "^3.1.11",
    "prettier": "^3.7.4",
    "sinon": "^21.0.1",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "type-coverage": "^2.29.7",
    "typedoc": "^0.28.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0"
  }
}