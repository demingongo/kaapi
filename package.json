{
    "name": "kaapi",
    "version": "1.0.0",
    "private": true,
    "description": "",
    "main": "index.js",
    "scripts": {
        "build": "pnpm -r build",
        "clean": "pnpm -r exec rimraf node_modules lib docs coverage && rimraf node_modules",
        "clean:build": "pnpm -r exec rimraf lib",
        "clean:deps": "pnpm -r exec rimraf node_modules && rimraf node_modules",
        "clean:coverage": "pnpm -r exec rimraf coverage",
        "doc": "pnpm --filter \"./packages/*\" -r doc",
        "format": "pnpm --filter \"./packages/*\" -r format",
        "format:check": "pnpm --filter \"./packages/*\" -r format:check",
        "lint": "pnpm -r lint",
        "test": "pnpm -r test",
        "test:integration": "pnpm -r test",
        "release:build": "pnpm --filter \"./packages/*\" -r build",
        "release:test": "pnpm --filter \"./packages/*\" -r test",
        "release:version": "pnpm --filter \"./packages/*\" -r exec npm version",
        "release:publish": "pnpm --filter \"./packages/*\" -r publish --access public",
        "version:patch": "pnpm --filter \"./packages/*\" -r exec npm version patch",
        "version:minor": "pnpm --filter \"./packages/*\" -r exec npm version minor",
        "version:major": "pnpm --filter \"./packages/*\" -r exec npm version major"
    },
    "keywords": [],
    "author": "demingongo",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/demingongo/kaapi.git"
    },
    "license": "MIT",
    "packageManager": "pnpm@10.20.0",
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.6",
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/chai": "^5.2.3",
        "@types/mocha": "^10.0.10",
        "@types/node": "^25.9.1",
        "@types/sinon": "^21.0.1",
        "@typescript-eslint/eslint-plugin": "^8.67.0",
        "@typescript-eslint/parser": "^8.67.0",
        "c8": "^11.0.0",
        "chai": "^6.2.2",
        "dependency-cruiser": "^17.4.0",
        "eslint": "^10.8.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import-x": "^4.17.1",
        "globals": "^17.11.0",
        "kaukau": "^4.2.1",
        "mocha": "^11.8.0",
        "nodemon": "^3.1.14",
        "prettier": "^3.8.3",
        "rimraf": "^6.1.3",
        "sinon": "^22.0.0",
        "ts-node": "^10.9.2",
        "tsup": "^8.5.1",
        "type-coverage": "^2.29.7",
        "typedoc": "^0.28.19",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.67.0"
    }
}