{
  "name": "examples-auth-saurbit",
  "version": "1.0.0",
  "description": "Authentication example using Saurbit's OAuth 2.0 server implementation.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && tsdown src/**/*.ts --format esm --out-dir dist --clean --sourcemap --unbundle --no-fixed-extension --no-dts",
    "dev": "tsx watch src/index.ts",
    "format": "prettier --write ./",
    "oneshot": "tsx watch src/oneshot.ts",
    "lint": "eslint .",
    "start": "node dist/index.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.8.0",
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@hapi/hoek": "^11.0.7",
    "@kaapi/kaapi": "workspace:^",
    "@kaapi/oauth2-auth-design": "workspace:^",
    "@saurbit/oauth2": "^0.1.13",
    "@saurbit/oauth2-jwt": "^0.1.9",
    "hapi-scalar": "^1.1.0",
    "joi": "^18.2.1"
  },
  "devDependencies": {
    "tsx": "^4.22.3"
  }
}