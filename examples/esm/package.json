{
    "name": "examples-esm",
    "version": "1.0.0",
    "description": "",
    "author": "",
    "license": "UNLICENSED",
    "private": true,
    "type": "module",
    "dependencies": {
        "@hapi/boom": "^10.0.1",
        "@hapi/hoek": "^11.0.7",
        "@hapi/vision": "^7.0.3",
        "@kaapi/cli": "workspace:^",
        "@kaapi/kaapi": "workspace:^",
        "@kaapi/oauth2-auth-design": "workspace:^",
        "@kaapi/validator-arktype": "workspace:^",
        "@kaapi/validator-valibot": "workspace:^",
        "@novice1/api-doc-generator": "^1.2.6",
        "@saurbit/oauth2": "^0.1.11",
        "@saurbit/oauth2-jwt": "^0.1.7",
        "arktype": "^2.2.0",
        "joi": "^18.2.1",
        "pug": "^3.0.4",
        "tslib": "^2.8.1",
        "winston": "^3.19.0"
    },
    "devDependencies": {
        "@dotenvx/dotenvx": "^1.67.0",
        "@types/mocha": "^10.0.10",
        "@types/pug": "^2.0.10",
        "c8": "^11.0.0",
        "chai": "^6.2.2",
        "dependency-cruiser": "^17.4.0",
        "eslint-import-resolver-typescript": "^4.4.4",
        "kaukau": "^4.2.1",
        "mocha": "^11.8.0",
        "shx": "^0.4.0",
        "tsx": "^4.22.3",
        "type-coverage": "^2.29.7"
    },
    "scripts": {
        "build": "npm run check && tsdown src/**/*.ts --format esm --out-dir dist --clean --sourcemap --unbundle --no-fixed-extension",
        "check": "tsc --noEmit",
        "check:deps": "depcruise src --validate",
        "ci": "npm run verify",
        "clean": "shx rm -rf dist coverage && echo Clean complete",
        "coverage": "c8 node --loader ts-node/esm --experimental-specifier-resolution=node --no-warnings ./node_modules/mocha/bin/mocha test/**/*.test.ts",
        "dev": "tsx watch --env-file=.env src/index.ts",
        "format": "dotenvx run -f .env.format -- prettier --write ./",
        "format:check": "dotenvx run -f .env.format -- prettier --check ./",
        "lint": "eslint .",
        "start": "node dist/index.js",
        "test": "node --loader ts-node/esm --experimental-specifier-resolution=node --no-warnings ./node_modules/mocha/bin/mocha test/**/*.test.ts",
        "test:kaukau": "node --loader ts-node/esm --experimental-specifier-resolution=node --no-warnings ./node_modules/kaukau/bin/kaukau -f test --ext .test.ts",
        "type-coverage": "type-coverage --at-least 90 --detail",
        "verify": "npm run lint && npm run format:check && npm run check && npm run check:deps && npm run type-coverage && npm run test:kaukau && npm run coverage"
    }
}